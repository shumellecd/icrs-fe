{
  "name": "icrs-fe",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive web interface for GOCC reporting, built with AlpineJS and Bootstrap 5.",
  "type": "module",
  "scripts": {
    "dev": "npm run scss && node bff/server.js",
    "dev:static": "npx serve -l 1001 .",
    "scss": "sass --load-path=node_modules --quiet-deps styles/main.scss styles/main.css",
    "scss:watch": "sass --load-path=node_modules --quiet-deps --watch styles/main.scss:styles/main.css",
    "test": "node --test tests/index.js",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "playwright": "^1.48.0",
    "sass": "^1.102.0"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "express": "^5.2.1"
  }
}
